# ─────────────────────────────────────────────────────────────
# Variables de entorno — Jalcruz First Class API
# En Railway, defínelas en Settings → Variables (NO subas el .env real).
# ─────────────────────────────────────────────────────────────

# Base de datos. Railway expone DATABASE_URL automáticamente al enlazar el
# servicio Postgres (formato: postgres://user:pass@host:port/db).
# La API la convierte sola a la cadena de Npgsql.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jalcruz_firstclass

# Alternativa local sin DATABASE_URL (usa ConnectionStrings:Default):
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=jalcruz_firstclass;Username=postgres;Password=postgres

# JWT — clave secreta larga (mínimo 32 chars). GENERA UNA NUEVA para producción.
Jwt__Key=cambia-esto-por-una-clave-secreta-larga-de-al-menos-32-caracteres
Jwt__Issuer=jalcruz-firstclass-api
Jwt__Audience=jalcruz-firstclass-web
Jwt__ExpiryHours=12

# Vida del token de la cuenta de servicio (POST /api/service-token), en DÍAS.
# Sólo afecta a esa cuenta: el login normal de las personas sigue en 12 h.
# 3650 = 10 años. n8n corre sin nadie mirando, y un token vencido se vería como
# 401 silenciosos en medio de una conversación real con un prospecto.
Jwt__ServiceTokenDays=3650

# CORS — orígenes del frontend separados por coma (dominio de Cloudflare Pages + local).
Cors__AllowedOrigins=https://tu-frontend.pages.dev,http://localhost:5173

# Super Admin inicial (solo se crea si la tabla users está vacía).
Seed__AdminEmail=admin@jalcruz.com
Seed__AdminPassword=CambiaEstaClave123!

# Cloudflare R2 — multimedia que la IA manda por WhatsApp.
# El bucket es PÚBLICO detrás de un dominio propio: Meta descarga el archivo
# desde sus servidores, así que la URL tiene que ser estable y sin credenciales.
# Si estas variables faltan, la API arranca igual y sólo /api/media responde 503.
#
# Las credenciales salen de R2 -> Manage API tokens, con permiso
# "Object Read & Write" acotado al bucket. Usar un **Account API Token**, no uno
# de usuario: el de usuario muere si esa persona sale de la cuenta, y se llevaría
# puesto el envío de multimedia.
R2__Endpoint=https://<account_id>.r2.cloudflarestorage.com
R2__AccessKeyId=
R2__SecretAccessKey=
R2__Bucket=media
R2__PublicBaseUrl=https://media.cruzk.dev

# Cuenta del CRM que recibe las conversaciones de WhatsApp derivadas por la IA
# (prospects.assigned_to_user_id). Sin AMBAS variables no se crea nada: no hay
# contraseña por defecto a propósito.
Seed__CrmUserName=Susanne
Seed__CrmUserEmail=
Seed__CrmUserPassword=

# Cuenta de servicio del agente de WhatsApp (la que usa n8n). Se crea sola al
# arrancar, con rol CRM Admin. NO lleva contraseña: se hashea un aleatorio que se
# descarta, así que no puede iniciar sesión ni aunque alguien tenga el email.
# Estas dos variables son opcionales, sólo cambian el nombre y el identificador.
Seed__AgentUserEmail=agente-whatsapp@firstclass.local
Seed__AgentUserName=Agente WhatsApp (n8n)
